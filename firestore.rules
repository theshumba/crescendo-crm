rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leads/{leadId} {
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null;
      // CREATES RE-ENABLED 2026-07-18 (June circuit-breaker lifted). The duplicate-minting
      // bug is closed client-side (clone-collapse merge + exact-name add guard), and every
      // new doc must be a sane, real lead:
      //  - doc id must match the payload id (no mismatched writes)
      //  - businessName must be a non-empty string (no ghost/blank docs)
      //  - demo/sample leads can never reach production
      //  - a doc can't be born already deleted (tombstones only ever update existing docs)
      allow create: if request.auth != null
        && request.resource.data.id == leadId
        && (request.resource.data.businessName is string)
        && request.resource.data.businessName.size() > 0
        && (!('source' in request.resource.data) || request.resource.data.source != 'sample')
        && (!('_deleted' in request.resource.data) || request.resource.data._deleted != true);
    }
  }
}
